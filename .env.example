# Harness Evolution 生产环境 .env 模板
#
# 用法：复制到服务器 /opt/harness/shared/.env（root 执行 chown deploy:deploy 与 chmod 600），
# 填好值后由 systemd 的 EnvironmentFile=/opt/harness/shared/.env 读取。真实 .env 不入仓库。
#
# 阅读约定：
#   必填 = 不填会导致服务拒绝启动、生产不可用，或首次部署没有可登录的管理员。
#   选填 = 有代码默认值或可留空；按实际接入的功能填写。
#   必填项保持为生效的赋值行；选填项默认在行首加 # 注释，按需去掉 # 后填值。
#   每行下一行是它的 必填/选填 说明。systemd EnvironmentFile 不支持行尾注释，
#   所以说明独立成行；复制时保留这些注释行，不要把注释写到赋值行末尾。
#   带尖括号或 CHANGE_ME 的值都是占位符，部署前必须替换。
#   变量以 HE_ 前缀为主；AI_AGENT_PROVIDER、ANTHROPIC_API_KEY、CLAUDE_CONFIG_DIR、
#   GIT_ASKPASS 是既有例外，语义见 apps/api/app/config.py 与 deploy/harness-api.service。
#
# 字段顺序：先必填，后选填；选填项默认全部注释。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

HE_PRODUCTION=true
# 必填｜开启生产模式。真实部署必须为 true；生产模式下 HE_DATA_DIR 必须是绝对路径，Secure Cookie 也按生产语义处理。默认 false。

HE_HOST=127.0.0.1
# 必填｜API 监听地址。生产只绑回环，由同机 nginx 反代 /api；8787 不对公网开放。默认 0.0.0.0，直接暴露端口不安全。

HE_DATA_DIR=/var/lib/harness-evolution/data
# 必填｜服务端数据目录，存放 target-content、repos、workspaces 等。必须是发布目录 /opt/harness/current 与 /opt/harness/releases 之外的绝对路径；systemd StateDirectory=harness-evolution 会创建并授权给 harness。路径变更等于数据迁移。

HE_JWT_SECRET=
# 必填｜JWT 签名密钥。用 openssl rand -hex 32 生成 64 位十六进制；为空时服务拒绝启动。不要复用其他环境，不要提交到仓库。

HE_DB_URL=mysql+asyncmy://harness:CHANGE_ME@127.0.0.1:3306/harness_evolution?charset=utf8mb4
# 必填｜生产 MySQL 连接串。bootstrap 已创建 harness_evolution 库与 harness@127.0.0.1 账号；密码在服务器 /root/harness-mysql-password.txt。把 CHANGE_ME 换成该密码；密码含 @ : / ? # 等字符时先做 URL 编码。

HE_ADMIN_USERNAME=admin
# 必填｜初始管理员用户名。首次启动 users 表为空时用它播种管理员；已有用户后不再生效。

HE_ADMIN_PASSWORD=
# 必填｜初始管理员密码。首次启动 users 表为空时与 HE_ADMIN_USERNAME 一起创建管理员；留空则不会创建，部署后无法登录。请填强密码，首次登录后立即在应用内修改。

# ---------------------------------------------------------------------------
# 选填：网络与站点
# ---------------------------------------------------------------------------

# HE_PORT=8787
# 选填｜API 监听端口，默认 8787。改端口时同步修改 nginx 的 /api 反代目标与安全组/探活配置。

# HE_WEB_BASE_URL=
# 选填｜站点外部地址，用于登录回调回跳和提交信息里的追溯链接。填 http://<公网IP>，绑域名并启用 HTTPS 后改为 https://<域名>；留空则回跳使用相对路径、提交信息不带站点链接。

# HE_LOG_LEVEL=info
# 选填｜日志级别，可选 critical / error / warning / info / debug，默认 info。生产建议 info；排障时临时改 debug。

# HE_DOCS_ENABLED=false
# 选填｜是否暴露 /api/docs 与 /api/openapi.json，默认 false。生产保持 false，避免公开接口文档。

# HE_CORS_ORIGINS=[]
# 选填｜允许跨域的前端源，必须是 JSON 数组，默认 ["http://localhost:5173"]。同源部署（nginx 同时托管前端）留 []；前后端分域时填 ["https://<前端域名>"]。裸字符串或非法 JSON 会让服务拒绝启动。

# HE_COOKIE_SECURE=
# 选填｜会话 Cookie 的 Secure 标记。留空按请求协议自动判断（HTTPS 才加 Secure）；TLS 在 nginx 终止且未传 X-Forwarded-Proto 时显式填 true。

# ---------------------------------------------------------------------------
# 选填：鉴权与会话
# ---------------------------------------------------------------------------

# HE_AUTH_PROVIDER=password
# 选填｜身份源，当前只支持 password；cookie / oidc 是预留值，选中会让服务拒绝启动。

# HE_SESSION_COOKIE_NAME=he_session
# 选填｜会话 Cookie 名，必须是 RFC 6265 token（字母、数字与 !#$%&'*+-.^_`|~），默认 he_session。

# HE_SESSION_TTL_HOURS=12
# 选填｜登录会话有效小时数，默认 12，范围 1–720。

# HE_ACCESS_TOKEN_TTL_MIN=30
# 选填｜访问令牌有效分钟数，默认 30，必须大于 0。

# HE_REFRESH_TOKEN_TTL_DAYS=14
# 选填｜刷新令牌有效天数，默认 14，必须大于 0。

# HE_LOGIN_RATE_LIMIT=10
# 选填｜单客户端登录尝试上限，默认 10，范围 1–10000。

# HE_EVENT_TICKET_TTL_SECONDS=60
# 选填｜SSE 事件票据有效秒数，默认 60，必须大于 0。

# HE_OIDC_ISSUER=
# 选填｜OIDC issuer 地址（仅 HE_AUTH_PROVIDER=oidc 时使用；当前 OIDC 适配器未启用）。必须是 http(s)、不带凭据、query 或 fragment。

# HE_OIDC_CLIENT_ID=
# 选填｜OIDC 客户端 ID（预留，当前不生效）。

# HE_OIDC_CLIENT_SECRET_ENV=
# 选填｜保存 OIDC 客户端密钥的环境变量名，不是密钥本身；只能填合法环境变量名（预留，当前不生效）。

# ---------------------------------------------------------------------------
# 选填：数据库调优
# ---------------------------------------------------------------------------

# HE_DB_DIALECT=mysql
# 选填｜数据库方言，可选 sqlite / mysql，默认 mysql。生产用 mysql；只有本地开发才用 sqlite。

# HE_DB_POOL_SIZE=10
# 选填｜数据库连接池常驻连接数，默认 10。

# HE_DB_MAX_OVERFLOW=20
# 选填｜连接池允许的临时溢出连接数，默认 20。

# HE_DB_ECHO=false
# 选填｜是否回显 SQL，默认 false。生产保持 false，避免日志泄露查询参数与拖慢服务。

# ---------------------------------------------------------------------------
# 选填：任务调度、SSE 与停机排水
# ---------------------------------------------------------------------------

# HE_SSE_HEARTBEAT_SECONDS=15
# 选填｜SSE 心跳间隔秒数，默认 15，必须大于 0。

# HE_SSE_QUEUE_CAPACITY=100
# 选填｜每个 SSE 连接的待发送队列容量，默认 100，必须大于 0。慢客户端队列满后会断开重连。

# HE_EVENT_REPLAY_LIMIT=500
# 选填｜事件重放上限，默认 500，范围 1–5000。重连时最多补发的事件条数。

# HE_SYNC_INTERVAL_SECONDS=60
# 选填｜上游同步轮询间隔秒数，默认 60，可为 0（关闭周期轮询）。

# HE_SYNC_LOCK_TTL_SECONDS=1800
# 选填｜同步锁租约秒数，默认 1800，必须大于 0；多实例或长任务时用于防止重复同步。

# HE_JOB_LEASE_SECONDS=90
# 选填｜任务租约秒数，默认 90，范围 10–86400。实例崩溃后租约到期才允许接管。

# HE_JOB_HEARTBEAT_SECONDS=15
# 选填｜任务心跳间隔秒数，默认 15，必须小于 HE_JOB_LEASE_SECONDS。默认值适用于单实例。

# HE_JOB_DRAIN_TIMEOUT_SECONDS=25
# 选填｜重启时等待在跑任务排水的秒数，默认 25。必须小于 systemd 的 TimeoutStopSec=45，否则进程会被强杀。

# HE_BLOCKED_SWEEP_SECONDS=30
# 选填｜扫描阻塞任务的间隔秒数，默认 30，必须大于等于 1。

# ---------------------------------------------------------------------------
# 选填：上游轨迹与外部表
# ---------------------------------------------------------------------------

# HE_UPSTREAM_BASE_URL=
# 选填｜上游轨迹服务地址。与 HE_UPSTREAM_TOKEN 都配置后才启用真实上游；留空按未配置降级。必须是 http(s)、不带凭据、query 或 fragment。

# HE_UPSTREAM_TOKEN=
# 选填｜上游轨迹服务的 Bearer Token；只从服务器环境或 GitHub Secrets 注入，不写入仓库。

# HE_UPSTREAM_API_MAJOR=1
# 选填｜上游 API 主版本，当前只接受 1，默认 1。

# HE_UPSTREAM_TIMEOUT_SECONDS=30
# 选填｜上游请求超时秒数，默认 30，范围 1–300。

# HE_UPSTREAM_RETRY_ATTEMPTS=3
# 选填｜上游请求重试次数，默认 3，范围 0–3。

# HE_UPSTREAM_RETRY_BACKOFF_SECONDS=0.25
# 选填｜上游重试退避基数秒数，默认 0.25，范围 0–30。

# HE_UPSTREAM_MAX_PAGES=100
# 选填｜单次上游分页抓取的最大页数，默认 100，范围 1–1000。

# HE_SESSION_QUERY_BASE_URL=
# 选填｜Session 轨迹查询服务地址；与 HE_SESSION_QUERY_TOKEN 都配置后才启用。必须是 http(s)、不带凭据。

# HE_SESSION_QUERY_TOKEN=
# 选填｜Session 轨迹查询服务的 Bearer Token；不写入仓库。

# HE_SESSION_QUERY_TIMEOUT_SECONDS=60
# 选填｜Session 查询超时秒数，默认 60，范围 1–300。

# HE_SESSION_QUERY_RETRY_ATTEMPTS=2
# 选填｜Session 查询重试次数，默认 2，范围 0–5。

# HE_SESSION_QUERY_RETRY_BACKOFF_SECONDS=0.25
# 选填｜Session 查询重试退避基数秒数，默认 0.25，范围 0–30。

# HE_BAD_CASE_QUERY_BASE_URL=
# 选填｜bad case 外部表查询服务地址；与 HE_BAD_CASE_QUERY_TOKEN 都配置后才启用。必须是 http(s)、不带凭据。

# HE_BAD_CASE_QUERY_TOKEN=
# 选填｜bad case 查询服务的 Bearer Token；不写入仓库。

# HE_BAD_CASE_QUERY_TIMEOUT_SECONDS=30
# 选填｜bad case 查询超时秒数，默认 30，范围 1–300。

# HE_BAD_CASE_QUERY_RETRY_ATTEMPTS=2
# 选填｜bad case 查询重试次数，默认 2，范围 0–5。

# HE_BAD_CASE_QUERY_RETRY_BACKOFF_SECONDS=0.25
# 选填｜bad case 查询重试退避基数秒数，默认 0.25，范围 0–30。

# HE_BAD_CASE_SYNC_INTERVAL_SECONDS=300
# 选填｜bad case 根因同步间隔秒数，默认 300，可为 0（关闭周期同步）。

# HE_BAD_CASE_SYNC_BATCH_SIZE=20
# 选填｜每批同步的 bad case 数，默认 20，范围 1–1000。

# HE_BAD_CASE_SYNC_TIME_BUDGET_SECONDS=600
# 选填｜单轮同步时间预算秒数，默认 600，范围 1–3600。

# HE_BAD_CASE_SYNC_MAX_AGENTS=200
# 选填｜单轮同步最多处理的 Agent 数，默认 200，范围 1–10000。

# HE_BAD_CASE_SYNC_MAX_DEPTH=10
# 选填｜Agent 树最大下钻深度，默认 10，范围 0–100。

# HE_BAD_CASE_SYNC_LEASE_SECONDS=900
# 选填｜bad case 同步租约秒数，默认 900，范围 30–86400；防止并发同步重复写入。

# HE_BAD_CASE_CATALOG_SYNC_INTERVAL_SECONDS=300
# 选填｜bad case 目录同步间隔秒数，默认 300，可为 0（关闭周期同步）。

# HE_BAD_CASE_CATALOG_SYNC_PAGE_SIZE=200
# 选填｜目录同步每页条数，默认 200，范围 1–200。

# HE_BAD_CASE_CATALOG_SYNC_TIME_BUDGET_SECONDS=300
# 选填｜目录同步单轮时间预算秒数，默认 300，范围 1–3600。

# HE_BAD_CASE_CATALOG_SYNC_MAX_PAGES=100
# 选填｜目录同步单轮最大页数，默认 100，范围 1–1000。

# HE_EXTERNAL_CONTRACT_CHECK_INTERVAL_SECONDS=300
# 选填｜外部表列/类型契约巡检间隔秒数，默认 300，范围 30–86400；漂移会写入 external.contract_drift 日志。

# ---------------------------------------------------------------------------
# 选填：Git 工作区与推送
# ---------------------------------------------------------------------------

# HE_GIT_PUSH=true
# 选填｜是否允许推送 run 分支与候选 tag，默认 true。只读的第三方仓库或演练环境设 false。

# HE_GIT_PUSH_PROVIDER=github
# 选填｜推送提供方，可选 github / gitlab，默认 github；未知值启动失败。

# HE_GIT_PUSH_TOKEN=
# 选填｜推送用 PAT；启用推送时必填，只从 GitHub Secrets 或服务器环境注入。配合 GIT_ASKPASS 使用，不写进 URL，不入库。

# HE_GIT_PUSH_URL=
# 选填｜可选的全局 fork/push URL 兜底；不填时由 provider 自动派生。支持 http(s)/ssh/git URL 或 scp-like remote，不能含密码/凭据。

# HE_GIT_PROXY=
# 选填｜Git 出网代理地址，只填本机回环 HTTP 代理，如 http://127.0.0.1:10801；未配置或探测失败时 git 直连。VLESS UUID/公钥只放 Xray 配置。

# HE_GIT_PROXY_PROBE_INTERVAL_SECONDS=60
# 选填｜代理健康探测间隔秒数，默认 60，范围 5–3600。探测失败会熔断回直连。

# HE_GIT_PROXY_PROBE_TIMEOUT_SECONDS=5
# 选填｜代理探测超时秒数，默认 5，必须大于 0 且不超过 30。

# GIT_ASKPASS=/opt/harness/shared/git-askpass.sh
# 选填｜Git 凭据助手脚本路径。Deploy 会固定注入该路径（0755、只读环境变量）；手工部署时填同一路径。

# ---------------------------------------------------------------------------
# 选填：AI Agent 与补丁生成
# ---------------------------------------------------------------------------

# AI_AGENT_PROVIDER=claude-code
# 选填｜AI Agent 提供方，可选 fake / claude-code，默认 claude-code。Claude 归因沿用公共模型。Linux 需可执行的 bubblewrap，安装与排查见 docs/deployment.md 的「归因运行时」。fake 可复用已有报告。

# HE_AI_AGENT_FAILURE_POLICY=
# 选填｜聚类 AI 失败策略，可选 strict / degrade；留空按 provider 推导（fake=degrade，其余=strict）。生产建议 strict，让失败显式暴露而不是落兜底分数。

# HE_AI_AGENT_CLAUDE_BIN=/opt/harness/shared/claude-code/current/usr/bin/claude
# 选填｜Claude Code CLI 路径。Deploy 安装后注入稳定 current 软链；手工部署时填绝对路径，不要用 ~（harness 用户没有 home）。

# HE_AI_AGENT_CLAUDE_SETTINGS=/opt/harness/shared/claude-code/config/settings.json
# 选填｜Claude Code 共享 settings 路径（0644，不含密钥）；Deploy 自动注入。

# CLAUDE_CONFIG_DIR=/opt/harness/shared/claude-code/config
# 选填｜Claude Code 配置目录；Deploy 自动注入。Claude Code CLI 从这里读取 settings 与凭据文件。

# ANTHROPIC_API_KEY=
# 选填｜Claude Code 调用所需 API Key；启用 claude-code 时必填，由 Deploy 从 CLAUDE_CODE_API_KEY 写入服务器 .env。只存服务器或 Secrets，不入库。

# HE_PATCH_SOURCE_MODE=placeholder
# 选填｜补丁来源，可选 placeholder / minimal-config / agent-edit，默认 placeholder。agent-edit 需要已配置 AI Agent provider。

# HE_ATTRIBUTION_ENGINE=rule-v1
# 选填｜归因引擎，当前默认 rule-v1；未知值启动失败。

# HE_ATTRIBUTION_DEFAULT_SKILL_PATH=/opt/harness/current/api/release-assets/attribute-badcases/SKILL.md
# 选填｜绑定归因使用的默认 Skill 路径。发布包自带该资产；只有自定义 Skill 时才需要改。

# HE_ATTRIBUTION_GOLDEN_SET_PATH=/opt/harness/current/api/release-assets/fixtures/attribution-golden/cases.json
# 选填｜归因 Golden 用例路径。发布包自带该资产；只有替换评测集时才需要改。

# HE_ATTRIBUTION_LLM=agent-native
# 选填｜归因模型名解析器，默认 agent-native 直接采用公共 Provider 选定的模型。

# HE_ATTRIBUTION_PACKAGE_DIR=/var/lib/harness-evolution/data/attribute
# 选填｜上传包、输入、快照与报告目录。生产默认 HE_DATA_DIR/attribute；只有需要独立持久卷时才显式设置。

# HE_ATTRIBUTION_CASE_CONCURRENCY=4
# 选填｜单批内并发处理的 bad case 数，默认 4，范围 1–32。

# HE_ATTRIBUTION_BATCH_CONCURRENCY=2
# 选填｜并发处理的批次数，默认 2，范围 1–8。

# HE_ATTRIBUTION_TIMEOUT_SECONDS=600
# 选填｜单个 bad case 归因超时秒数，默认 600，范围 1–3600。

# ---------------------------------------------------------------------------
# 选填：自进化评测
# ---------------------------------------------------------------------------

# HE_EVAL_MODE=fake
# 选填｜评测网关模式，可选 fake / http，默认 fake。fake 返回占位分数；http 接真实评测平台，需要 HE_EVAL_BASE_URL。

# HE_EVAL_BASE_URL=
# 选填｜真实评测平台地址，仅 http(s)、不带凭据、query 或 fragment；HE_EVAL_MODE=http 时必填。

# HE_EVAL_API_KEY=
# 选填｜评测平台密钥；服务只保存 apiKeyRef（环境变量名），密钥值不落库。由 Deploy 从 GitHub Secrets 注入。

# HE_EVAL_SCAN_SECONDS=30
# 选填｜扫描待评测任务的间隔秒数，默认 30，必须大于 0 且不超过 300。

# HE_EVAL_POLL_SECONDS=300
# 选填｜轮询评测结果的间隔秒数，默认 300，必须大于 0。

# HE_EVAL_TIMEOUT_SECONDS=7200
# 选填｜单次评测超时秒数，默认 7200，必须大于 0。

# ---------------------------------------------------------------------------
# 选填：服务阶段与构建元数据
# ---------------------------------------------------------------------------

# HE_PHASE=scaffold
# 选填｜健康检查返回的服务阶段，可选 scaffold / demo / live，默认 scaffold。设为 live 会拒绝 seed 与本地导入；真实部署通常保持默认。

# HE_VERSION=0.1.0
# 选填｜健康检查返回的版本号，默认 0.1.0；通常由发布元数据决定，不要手改。
