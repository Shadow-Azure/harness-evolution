{
  "name": "harness-evolution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @harness/server --filter @harness/web dev",
    "dev:server": "pnpm --filter @harness/server dev",
    "dev:web": "pnpm --filter @harness/web dev",
    "build": "pnpm --filter @harness/server build && pnpm --filter @harness/web build",
    "start": "pnpm --filter @harness/server start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
