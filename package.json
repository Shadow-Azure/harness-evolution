{
  "name": "harness-evolution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/run-api.mjs dev",
    "dev:web": "pnpm --filter @harness/web dev",
    "build": "pnpm --filter @harness/web build",
    "lint:web": "pnpm --filter @harness/web lint",
    "start": "node scripts/run-api.mjs start",
    "setup:api": "node scripts/setup-api.mjs",
    "lint:api": "node scripts/run-api.mjs lint",
    "test:api": "node scripts/run-api.mjs test",
    "test:db": "node scripts/run-api.mjs db",
    "test:db:mysql": "node scripts/run-api.mjs db-mysql",
    "test:web": "pnpm --filter @harness/web test",
    "test:integration": "node --test tests/integration/web-api-proxy.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "fixtures:seed": "node scripts/fixtures-seed.mjs",
    "test:all": "pnpm test:web && pnpm test:api && pnpm test:db:mysql && pnpm test:integration && pnpm test:e2e",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:check": "node scripts/contract.mjs check",
    "typecheck:api": "node scripts/run-api.mjs typecheck",
    "typecheck": "pnpm -r typecheck",
    "typecheck:web": "pnpm --filter @harness/web typecheck",
    "test": "pnpm test:web && pnpm test:api",
    "test:gates": "node --test scripts/gates.spec.mjs",
    "lint:docs": "node scripts/run-gates.mjs --mode doc-quick",
    "verify:docs": "node scripts/run-gates.mjs --mode doc-sync",
    "verify:flow": "node scripts/verify-flow.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:web-style": "node scripts/verify-web-style.mjs",
    "verify:flow-online": "node scripts/verify-flow-online.mjs",
    "flow:sync": "node scripts/flow-sync.mjs",
    "flow:new-issue": "node scripts/flow-new-issue.mjs",
    "record:i18n": "node scripts/verify-translation-pairing.mjs --write",
    "route:gates": "node scripts/route-gates.mjs",
    "archive:note": "node scripts/archive-agent-note.mjs",
    "install:hooks": "node scripts/install-git-hooks.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
