{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "additionalProperties": false,
        "description": "Owner-supplied current and replacement passwords.",
        "properties": {
          "newPassword": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Newpassword",
            "type": "string"
          },
          "oldPassword": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Oldpassword",
            "type": "string"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "CreateUserRequest": {
        "additionalProperties": false,
        "description": "Administrator-provisioned account with a temporary password.",
        "properties": {
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Displayname",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "default": "member",
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "displayName",
          "password"
        ],
        "title": "CreateUserRequest",
        "type": "object"
      },
      "DatabaseDialect": {
        "description": "Supported SQLAlchemy database dialects.",
        "enum": [
          "sqlite",
          "mysql"
        ],
        "title": "DatabaseDialect",
        "type": "string"
      },
      "DatabaseHealthResponse": {
        "additionalProperties": false,
        "description": "Sanitized database health included in the public health response.",
        "properties": {
          "dialect": {
            "$ref": "#/components/schemas/DatabaseDialect"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latencyMs": {
            "title": "Latencyms",
            "type": "number"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "dialect",
          "ok",
          "latencyMs"
        ],
        "title": "DatabaseHealthResponse",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "Error payload shared by browser and API clients.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable machine-readable error codes.",
        "enum": [
          "AUTH_REQUIRED",
          "AUTH_INVALID",
          "AUTH_EXPIRED",
          "TICKET_INVALID",
          "TICKET_EXPIRED",
          "FORBIDDEN",
          "PASSWORD_CHANGE_REQUIRED",
          "USERNAME_CONFLICT",
          "JOB_NOT_FOUND",
          "RUN_BUSY",
          "INTERNAL",
          "METHOD_NOT_ALLOWED",
          "NOT_FOUND",
          "VALIDATION_INVALID",
          "RATE_LIMITED"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Top-level failure response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventTicketResponse": {
        "additionalProperties": false,
        "description": "Opaque single-use grant for one SSE connection.",
        "properties": {
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "ticket": {
            "title": "Ticket",
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "ticket",
          "expiresIn",
          "topics"
        ],
        "title": "EventTicketResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Public health-check contract.",
        "properties": {
          "db": {
            "$ref": "#/components/schemas/DatabaseHealthResponse"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "phase": {
            "$ref": "#/components/schemas/ServicePhase"
          },
          "service": {
            "const": "harness-evolution",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "phase",
          "version",
          "db"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobResponse": {
        "additionalProperties": false,
        "description": "Durable job state returned as the REST source of truth.",
        "properties": {
          "attempt": {
            "minimum": 0.0,
            "title": "Attempt",
            "type": "integer"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "createdBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdby"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "finishedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finishedat"
          },
          "jobId": {
            "title": "Jobid",
            "type": "string"
          },
          "kind": {
            "enum": [
              "sync",
              "pull",
              "evolution_prepare",
              "evolution_advance",
              "evolution_apply",
              "evolution_finalize",
              "evolution_retry"
            ],
            "title": "Kind",
            "type": "string"
          },
          "progress": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "refId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Refid"
          },
          "startedAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Startedat"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "interrupted"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "jobId",
          "kind",
          "refId",
          "status",
          "progress",
          "attempt",
          "createdBy",
          "createdAt",
          "startedAt",
          "finishedAt",
          "error"
        ],
        "title": "JobResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Credentials exchanged for a bearer token and refresh cookie.",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "description": "Successful authentication result.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "PublicUser": {
        "additionalProperties": false,
        "description": "User fields safe for browser and API clients.",
        "properties": {
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mustChangePassword": {
            "title": "Mustchangepassword",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "mustChangePassword"
        ],
        "title": "PublicUser",
        "type": "object"
      },
      "RefreshResponse": {
        "additionalProperties": false,
        "description": "Successful refresh result; callers reload `/api/auth/me` for user fields.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ],
        "title": "RefreshResponse",
        "type": "object"
      },
      "ServicePhase": {
        "description": "Delivery phase exposed by the health endpoint.",
        "enum": [
          "scaffold",
          "demo",
          "live"
        ],
        "title": "ServicePhase",
        "type": "string"
      },
      "TicketRequest": {
        "additionalProperties": false,
        "description": "Run topics and optional replay cursor bound to an event ticket.",
        "properties": {
          "lastEventId": {
            "default": 0,
            "minimum": 0.0,
            "title": "Lasteventid",
            "type": "integer"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "topics"
        ],
        "title": "TicketRequest",
        "type": "object"
      },
      "UserListResponse": {
        "additionalProperties": false,
        "description": "Small unpaginated administrator user list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicUser"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "UserListResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Short-lived access JWT returned by POST /api/auth/login.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "harness-evolution-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/change-password": {
      "post": {
        "description": "Replace the authenticated user's password and clear forced-change state.",
        "operationId": "change_password_api_auth_change_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Password change is required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Exchange a username and password for a short-lived access token.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid username or password"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account is inactive"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many login attempts"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Revoke the presented refresh token and clear its restricted cookie.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Return the current identity with its forced-change state.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Rotate the refresh cookie and issue a fresh bearer access token.",
        "operationId": "refresh_api_auth_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Refresh token is invalid or expired"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account is inactive"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/events": {
      "get": {
        "description": "Consume a one-time ticket and stream replay plus live run notifications.",
        "operationId": "event_stream_api_events_get",
        "parameters": [
          {
            "in": "query",
            "name": "ticket",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ticket"
            }
          },
          {
            "in": "header",
            "name": "Last-Event-ID",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Last-Event-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "additionalProperties": false,
                  "description": "Logical Server-Sent Event frame documented for typed browser clients.",
                  "properties": {
                    "data": {
                      "additionalProperties": true,
                      "title": "Data",
                      "type": "object"
                    },
                    "event": {
                      "enum": [
                        "ping",
                        "run.event",
                        "run.progress",
                        "run.blocked",
                        "run.resumed",
                        "run.completed",
                        "run.failed",
                        "run.interrupted",
                        "reset"
                      ],
                      "title": "Event",
                      "type": "string"
                    },
                    "id": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "title": "Id"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ],
                  "title": "SSEEventFrame",
                  "type": "object"
                }
              }
            },
            "description": "Server-Sent Event frames for authorized run topics"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Event ticket is invalid or expired"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Replay cursor is invalid"
          }
        },
        "summary": "Event Stream",
        "tags": [
          "events"
        ]
      }
    },
    "/api/events/ticket": {
      "post": {
        "description": "Bind authenticated run topics and a cursor to a single-use ticket.",
        "operationId": "issue_ticket_api_events_ticket_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTicketResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication or ticket input is invalid"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Password change is required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Issue Ticket",
        "tags": [
          "events"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Report API reachability, delivery phase, and database health.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/jobs/{jobId}": {
      "get": {
        "description": "Return the latest durable state for one job.",
        "operationId": "get_job_api_jobs__jobId__get",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "title": "Jobid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
