{
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "additionalProperties": false,
        "description": "Owner-supplied current and replacement passwords.",
        "properties": {
          "newPassword": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Newpassword",
            "type": "string"
          },
          "oldPassword": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Oldpassword",
            "type": "string"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "CreateUserRequest": {
        "additionalProperties": false,
        "description": "Administrator-provisioned account with a temporary password.",
        "properties": {
          "displayName": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Displayname",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "default": "member",
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "displayName",
          "password"
        ],
        "title": "CreateUserRequest",
        "type": "object"
      },
      "DatabaseDialect": {
        "description": "Supported SQLAlchemy database dialects.",
        "enum": [
          "sqlite",
          "mysql"
        ],
        "title": "DatabaseDialect",
        "type": "string"
      },
      "DatabaseHealthResponse": {
        "additionalProperties": false,
        "description": "Sanitized database health included in the public health response.",
        "properties": {
          "dialect": {
            "$ref": "#/components/schemas/DatabaseDialect"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "latencyMs": {
            "title": "Latencyms",
            "type": "number"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
          "dialect",
          "ok",
          "latencyMs"
        ],
        "title": "DatabaseHealthResponse",
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "Error payload shared by browser and API clients.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorCode": {
        "description": "Stable machine-readable error codes.",
        "enum": [
          "AUTH_REQUIRED",
          "AUTH_INVALID",
          "AUTH_EXPIRED",
          "TICKET_INVALID",
          "TICKET_EXPIRED",
          "FORBIDDEN",
          "PASSWORD_CHANGE_REQUIRED",
          "USERNAME_CONFLICT",
          "INTERNAL",
          "METHOD_NOT_ALLOWED",
          "NOT_FOUND",
          "VALIDATION_INVALID",
          "RATE_LIMITED"
        ],
        "title": "ErrorCode",
        "type": "string"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "description": "Top-level failure response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventTicketResponse": {
        "additionalProperties": false,
        "description": "Opaque single-use grant for a future SSE connection.",
        "properties": {
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "ticket": {
            "title": "Ticket",
            "type": "string"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "ticket",
          "expiresIn",
          "topics"
        ],
        "title": "EventTicketResponse",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Public health-check contract.",
        "properties": {
          "db": {
            "$ref": "#/components/schemas/DatabaseHealthResponse"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "phase": {
            "$ref": "#/components/schemas/ServicePhase"
          },
          "service": {
            "const": "harness-evolution",
            "title": "Service",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "ok",
          "service",
          "phase",
          "version",
          "db"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "description": "Credentials exchanged for a bearer token and refresh cookie.",
        "properties": {
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "additionalProperties": false,
        "description": "Successful authentication result.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/PublicUser"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "PublicUser": {
        "additionalProperties": false,
        "description": "User fields safe for browser and API clients.",
        "properties": {
          "displayName": {
            "title": "Displayname",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "mustChangePassword": {
            "title": "Mustchangepassword",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "admin",
              "member"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "role",
          "mustChangePassword"
        ],
        "title": "PublicUser",
        "type": "object"
      },
      "RefreshResponse": {
        "additionalProperties": false,
        "description": "Successful refresh result; callers reload `/api/auth/me` for user fields.",
        "properties": {
          "accessToken": {
            "title": "Accesstoken",
            "type": "string"
          },
          "expiresIn": {
            "title": "Expiresin",
            "type": "integer"
          }
        },
        "required": [
          "accessToken",
          "expiresIn"
        ],
        "title": "RefreshResponse",
        "type": "object"
      },
      "ServicePhase": {
        "description": "Delivery phase exposed by the health endpoint.",
        "enum": [
          "scaffold",
          "demo",
          "live"
        ],
        "title": "ServicePhase",
        "type": "string"
      },
      "TicketRequest": {
        "additionalProperties": false,
        "description": "Run topics and optional replay cursor bound to an event ticket.",
        "properties": {
          "lastEventId": {
            "default": 0,
            "minimum": 0.0,
            "title": "Lasteventid",
            "type": "integer"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "title": "Topics",
            "type": "array"
          }
        },
        "required": [
          "topics"
        ],
        "title": "TicketRequest",
        "type": "object"
      },
      "UserListResponse": {
        "additionalProperties": false,
        "description": "Small unpaginated administrator user list.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicUser"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "UserListResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "description": "Short-lived access JWT returned by POST /api/auth/login.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "harness-evolution-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/change-password": {
      "post": {
        "description": "Replace the authenticated user's password and clear forced-change state.",
        "operationId": "change_password_api_auth_change_password_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Password change is required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Change Password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Exchange a username and password for a short-lived access token.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid username or password"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account is inactive"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many login attempts"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Revoke the presented refresh token and clear its restricted cookie.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Return the current identity with its forced-change state.",
        "operationId": "me_api_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Me",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/refresh": {
      "post": {
        "description": "Rotate the refresh cookie and issue a fresh bearer access token.",
        "operationId": "refresh_api_auth_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Refresh token is invalid or expired"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Account is inactive"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/events/ticket": {
      "post": {
        "description": "Bind authenticated run topics and a cursor to a single-use ticket.",
        "operationId": "issue_ticket_api_events_ticket_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventTicketResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication or ticket input is invalid"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Password change is required"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Issue Ticket",
        "tags": [
          "events"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Report API reachability, delivery phase, and database health.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/users": {
      "get": {
        "description": "List all users in the single organization.",
        "operationId": "list_users_api_users_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Administrator role is required"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List Users",
        "tags": [
          "users"
        ]
      },
      "post": {
        "description": "Provision a user whose first login must change its temporary password.",
        "operationId": "create_user_api_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUser"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Authentication is required"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Administrator role is required"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Username already exists"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request validation failed"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Create User",
        "tags": [
          "users"
        ]
      }
    }
  }
}
