        "detectionPointRequired": true
      }
    },
    {
      "id": "multi-object-ambiguous",
      "scenario": "Another object is present and ordering cannot identify the selected object as root cause.",
      "tags": ["negative", "multi-object"],
      "input": {
        "sessionId": "golden-session-06",
        "badCaseType": "discovery",
        "title": "Synthetic ambiguous multi-object issue",
        "description": "Only selected-object coordinates are retained; unrelated object content is omitted.",
        "hitReason": "order_unknown",
        "orderState": "unknown",
        "context": {
          "agentNodes": [{"agentId": "f0", "treeIndex": 0}],
          "objectOccurrences": [
            {"agentId": "f0", "eventIndex": 3, "treeIndex": 0, "objectRevision": "revision:1"}
          ],
          "reportAgentId": "f0",
          "reportEventIndex": 7,
          "pathAgentIds": ["f0"]
        }
      },
      "expected": {
        "conclusion": "inconclusive",
        "requiredEvidenceRefs": ["event:f0:3", "event:f0:7"]
      }
    },
    {
      "id": "missing-trace",
      "scenario": "Missing Session trace context degrades to inconclusive without invented evidence.",
      "tags": ["negative", "missing-context"],
      "input": {
        "sessionId": "golden-session-07",
        "badCaseType": "discovery",
        "title": "Synthetic report without trace coordinates",
        "description": "No object occurrence or report node is available.",
        "hitReason": "order_unknown",
        "orderState": "unknown",
        "context": {
          "warnings": ["SELECTED_OBJECT_OCCURRENCE_MISSING", "BADCASE_REPORT_NODE_MISSING"]
        }
      },
      "expected": {"conclusion": "inconclusive"}
    },
    {
      "id": "relation-degraded",
      "scenario": "A broken Agent relation remains inconclusive and exposes only valid local coordinates.",
      "tags": ["negative", "relation-degraded"],
      "input": {
        "sessionId": "golden-session-08",
        "badCaseType": "discovery",
        "title": "Synthetic relation cannot be reconstructed",
        "description": "The report node is outside the retained object path.",
        "hitReason": "order_unknown",
        "orderState": "unknown",
        "context": {
          "agentNodes": [
            {"agentId": "h0", "treeIndex": 0},
            {"agentId": "h9", "treeIndex": 9}
          ],
          "objectOccurrences": [
            {"agentId": "h0", "eventIndex": 1, "treeIndex": 0, "objectRevision": "revision:1"}
          ],
          "reportAgentId": "h9",
          "reportEventIndex": 4,
          "warnings": ["AGENT_RELATION_DEGRADED"]
        }
      },
      "expected": {
        "conclusion": "inconclusive",
        "requiredEvidenceRefs": ["event:h0:1", "event:h9:4"]
      }
    },
    {
      "id": "non-skill-problem",
