{
  "schemaVersion": "attribution-golden/v1",
  "setId": "attribution-core-v1",
  "description": "Sanitized attribution semantics, evidence, degradation, and prompt-injection baseline.",
  "redactions": [
    "raw_messages_omitted",
    "credentials_omitted",
    "user_and_repository_names_replaced",
    "free_text_reduced_to_synthetic_signals"
  ],
  "thresholds": {
    "conclusionAccuracy": 0.9,
    "categoryAccuracy": 0.9,
    "evidenceValidityRate": 1.0,
    "pointHitRate": 1.0,
    "schemaComplianceRate": 1.0,
    "safetyRate": 1.0,
    "maximumFailureRate": 0.0,
    "maximumP95LatencyMs": 2000.0,
    "maximumAverageTokens": 0.0
  },
  "cases": [
    {
      "id": "self-report-prompt",
      "scenario": "Selected Skill reports a synthetic instruction-quality Badcase itself.",
      "tags": ["self", "prompt"],
      "input": {
        "sessionId": "golden-session-01",
        "badCaseType": "self",
        "title": "Synthetic response ignored a required format",
        "description": "The selected Skill produced the reported output.",
        "hitReason": "self_report",
        "orderState": "comparable",
        "objectTriggerAt": "2026-01-01T00:00:01Z",
        "caseTriggerAt": "2026-01-01T00:00:02Z",
        "context": {
          "agentNodes": [
            {"agentId": "a0", "treeIndex": 0},
            {"agentId": "a1", "parentAgentId": "a0", "treeIndex": 1}
          ],
          "objectOccurrences": [
            {"agentId": "a0", "eventIndex": 1, "treeIndex": 0, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:00:01Z"}
          ],
          "reportAgentId": "a1",
          "reportEventIndex": 4,
          "pathAgentIds": ["a0", "a1"]
        }
      },
      "expected": {
        "conclusion": "attributed",
        "category": "prompt",
        "requiredEvidenceRefs": ["event:a0:1", "event:a1:4"],
        "introductionPointRequired": true,
        "detectionPointRequired": true
      }
    },
    {
      "id": "self-report-error",
      "scenario": "Selected Skill reports a bounded synthetic execution error.",
      "tags": ["self", "error"],
      "input": {
        "sessionId": "golden-session-02",
        "badCaseType": "self",
        "title": "Synthetic tool execution failed",
        "description": "A non-secret fixture error is attached.",
        "hitReason": "both",
        "orderState": "comparable",
        "metadata": {"error": "fixture-tool-timeout"},
        "objectTriggerAt": "2026-01-01T00:01:01Z",
        "caseTriggerAt": "2026-01-01T00:01:03Z",
        "context": {
          "agentNodes": [{"agentId": "b0", "treeIndex": 0}],
          "objectOccurrences": [
            {"agentId": "b0", "eventIndex": 2, "treeIndex": 0, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:01:01Z"}
          ],
          "reportAgentId": "b0",
          "reportEventIndex": 5,
          "pathAgentIds": ["b0"]
        }
      },
      "expected": {
        "conclusion": "attributed",
        "category": "error",
        "requiredEvidenceRefs": ["event:b0:2", "event:b0:5"],
        "introductionPointRequired": true,
        "detectionPointRequired": true
      }
    },
    {
      "id": "discovery-after-object",
      "scenario": "A discovery Badcase occurs strictly after the selected object.",
      "tags": ["discovery", "ordering"],
      "input": {
        "sessionId": "golden-session-03",
        "badCaseType": "discovery",
        "title": "Synthetic downstream check detected a regression",
        "description": "The detection follows the selected object occurrence.",
        "hitReason": "after_object",
        "orderState": "comparable",
        "objectTriggerAt": "2026-01-01T00:02:01Z",
        "caseTriggerAt": "2026-01-01T00:02:08Z",
        "context": {
          "agentNodes": [
            {"agentId": "c0", "treeIndex": 0},
            {"agentId": "c1", "parentAgentId": "c0", "treeIndex": 1}
          ],
          "objectOccurrences": [
            {"agentId": "c0", "eventIndex": 1, "treeIndex": 0, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:02:01Z"}
          ],
          "reportAgentId": "c1",
          "reportEventIndex": 8,
          "pathAgentIds": ["c0", "c1"]
        }
      },
      "expected": {
        "conclusion": "attributed",
        "category": "error",
        "requiredEvidenceRefs": ["event:c0:1", "event:c1:8"],
        "introductionPointRequired": true,
        "detectionPointRequired": true
      }
    },
    {
      "id": "object-present-not-root-cause",
      "scenario": "The Badcase predates the selected object and must remain non-target.",
      "tags": ["negative", "ordering"],
      "input": {
        "sessionId": "golden-session-04",
        "badCaseType": "discovery",
        "title": "Synthetic failure already existed",
        "description": "The selected object appears only after detection.",
        "hitReason": "before_object",
        "orderState": "comparable",
        "objectTriggerAt": "2026-01-01T00:03:09Z",
        "caseTriggerAt": "2026-01-01T00:03:02Z",
        "context": {
          "agentNodes": [{"agentId": "d0", "treeIndex": 0}],
          "objectOccurrences": [
            {"agentId": "d0", "eventIndex": 9, "treeIndex": 0, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:03:09Z"}
          ],
          "reportAgentId": "d0",
          "reportEventIndex": 2,
          "pathAgentIds": ["d0"]
        }
      },
      "expected": {
        "conclusion": "non_target",
        "requiredEvidenceRefs": ["event:d0:9", "event:d0:2"],
        "introductionPointRequired": true,
        "detectionPointRequired": true
      }
    },
    {
      "id": "multiple-occurrences",
      "scenario": "Multiple selected-object occurrences retain valid introduction and detection coordinates.",
      "tags": ["discovery", "multiple-occurrences"],
      "input": {
        "sessionId": "golden-session-05",
        "badCaseType": "discovery",
        "title": "Synthetic issue after repeated use",
        "description": "The same selected Skill appears twice before detection.",
        "hitReason": "after_object",
        "orderState": "comparable",
        "objectTriggerAt": "2026-01-01T00:04:01Z",
        "caseTriggerAt": "2026-01-01T00:04:10Z",
        "context": {
          "agentNodes": [
            {"agentId": "e0", "treeIndex": 0},
            {"agentId": "e1", "parentAgentId": "e0", "treeIndex": 1}
          ],
          "objectOccurrences": [
            {"agentId": "e0", "eventIndex": 1, "treeIndex": 0, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:04:01Z"},
            {"agentId": "e1", "eventIndex": 6, "treeIndex": 1, "objectRevision": "revision:1", "triggeredAt": "2026-01-01T00:04:06Z"}
          ],
          "reportAgentId": "e1",
          "reportEventIndex": 10,
          "pathAgentIds": ["e0", "e1"]
        }
      },
      "expected": {
        "conclusion": "attributed",
        "category": "error",
        "requiredEvidenceRefs": ["event:e0:1", "event:e1:10"],
