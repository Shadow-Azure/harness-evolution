# Harness Evolution API 生产环境模板
# 用法：复制到服务器 /opt/harness/shared/.env 后填值；真实 .env 只在服务器，不入仓库。
# 所有变量带 HE_ 前缀（见 apps/api/app/config.py）。

# ---- 网络 ----
# 只监听本机回环，公网流量一律经 nginx 反代
HE_HOST=127.0.0.1
HE_PORT=8787
HE_PRODUCTION=true
HE_LOG_LEVEL=info
HE_DOCS_ENABLED=false

# ---- 必填：JWT 签名密钥（openssl rand -hex 32 生成；为空服务拒绝启动）----
HE_JWT_SECRET=

# ---- 必填：生产主库 MySQL（bootstrap-server.sh 创建同名库与账号）----
HE_DB_DIALECT=mysql
HE_DB_URL=mysql+asyncmy://harness:CHANGE_ME@127.0.0.1:3306/harness_evolution?charset=utf8mb4

# ---- 必填：初始管理员（users 表为空时播种一次，之后改密码走应用内）----
HE_ADMIN_USERNAME=admin
HE_ADMIN_PASSWORD=

# ---- 站点地址：先用 IP 部署填 http://<公网IP>；绑域名后改 https://<域名> ----
HE_WEB_BASE_URL=

# ---- CORS：list 字段必须 JSON 数组语法（裸字符串会让服务拒绝启动）----
# 例：HE_CORS_ORIGINS=["http://8.149.232.63"] 或 ["https://example.com"]；同源托管填空数组即可
HE_CORS_ORIGINS=[]

# ---- 上游集成（暂不接保持留空，服务按未配置降级）----
HE_UPSTREAM_BASE_URL=
HE_UPSTREAM_TOKEN=
HE_SESSION_QUERY_BASE_URL=
HE_SESSION_QUERY_TOKEN=
HE_BAD_CASE_QUERY_BASE_URL=
HE_BAD_CASE_QUERY_TOKEN=
