# Harness Evolution API 生产环境模板
# 用法：复制到服务器 /opt/harness/shared/.env 后填值；真实 .env 只在服务器，不入仓库。
# 变量以 HE_ 前缀为主，少数既有配置名例外（如 AI_AGENT_PROVIDER、GIT_ASKPASS；见 apps/api/app/config.py）。

# ---- 网络 ----
# 只监听本机回环，公网流量一律经 nginx 反代
HE_HOST=127.0.0.1
HE_PORT=8787
HE_PRODUCTION=true
HE_LOG_LEVEL=info
HE_DOCS_ENABLED=false

# ---- 数据目录：生产必须为绝对路径；由 systemd StateDirectory=harness-evolution 创建并授权 ----
# 路径不得位于 /opt/harness/current 或 /opt/harness/releases，不得含空白/换行/..。
# deploy 流水线总是从 GitHub Environment vars.HE_DATA_DIR 注入（空=本默认值）；路径变更等于数据迁移。
HE_DATA_DIR=/var/lib/harness-evolution/data

# 每个 release 自带平台默认 Skill、固定报告脚本和 Golden 用例。上传包及分析结果共用持久数据卷。
HE_ATTRIBUTION_DEFAULT_SKILL_PATH=/opt/harness/current/api/release-assets/attribute-badcases/SKILL.md
HE_ATTRIBUTION_GOLDEN_SET_PATH=/opt/harness/current/api/release-assets/fixtures/attribution-golden/cases.json
# Linux 服务账号可运行 bubblewrap 后，可开启绑定归因；共用下方生产 Claude 路径与端点。
# HE_ATTRIBUTION_AGENT=claude
# HE_ATTRIBUTION_MODEL=haiku
# 上传包与输出默认位于 HE_DATA_DIR/attribute；需要独立持久卷时显式设置 HE_ATTRIBUTION_PACKAGE_DIR。

# ---- Git 出网代理（可选；由 deploy 流水线按 GitHub Environment Secret XRAY_CONFIG 注入）----
# 只填本机 HTTP 代理地址；VLESS UUID/公钥只在 Xray 配置中，不写这里、不落 API。
# 未配置或代理探测失败时流水线会移除该键，git 直连。
HE_GIT_PROXY=

# ---- Git 工作区推送（可选；见 docs/git-workspace.md）----
# HE_GIT_PUSH=true：prepare/candidate/接纳时推送 run 分支与候选 tag；第三方只读仓库请设 false。
# HE_GIT_PUSH_PROVIDER：github（默认）/ gitlab；选择 GitPushProvider 子类，未知值启动失败。
# HE_GIT_PUSH_TOKEN：PAT；只从 Secrets / 服务器环境注入，配合 GIT_ASKPASS，不写 URL、不入库。
# GIT_ASKPASS 由 Deploy 固定为 /opt/harness/shared/git-askpass.sh（0755，只读环境变量）。
# HE_GIT_PUSH_URL：可选的全局 fork / push URL 兜底；run 在 prepare 派生的 pushRepoUrl 与评测同源。
HE_GIT_PUSH=true
HE_GIT_PUSH_PROVIDER=github
HE_GIT_PUSH_TOKEN=
HE_GIT_PUSH_URL=

# ---- 必填：JWT 签名密钥（openssl rand -hex 32 生成；为空服务拒绝启动）----
HE_JWT_SECRET=

# ---- 必填：生产主库 MySQL（bootstrap-server.sh 创建同名库与账号）----
HE_DB_DIALECT=mysql
HE_DB_URL=mysql+asyncmy://harness:CHANGE_ME@127.0.0.1:3306/harness_evolution?charset=utf8mb4

# ---- 必填：初始管理员（users 表为空时播种一次，之后改密码走应用内）----
HE_ADMIN_USERNAME=admin
HE_ADMIN_PASSWORD=

# ---- 站点地址：先用 IP 部署填 http://<公网IP>；绑域名后改 https://<域名> ----
HE_WEB_BASE_URL=

# ---- Cookie Secure 标记：留空=按请求协议自动（HTTPS 才加 Secure）；
# 若 TLS 在代理层终止且未传 X-Forwarded-Proto，显式填 true ----
HE_COOKIE_SECURE=

# ---- 鉴权接入（V2 预留；当前只支持 password，cookie/oidc 选择会拒绝启动）----
# HE_OIDC_CLIENT_SECRET_ENV 填保存客户端密钥的环境变量名，不填密钥本身。
HE_AUTH_PROVIDER=password
HE_SESSION_COOKIE_NAME=he_session
HE_SESSION_TTL_HOURS=12
HE_OIDC_ISSUER=
HE_OIDC_CLIENT_ID=
HE_OIDC_CLIENT_SECRET_ENV=

# ---- CORS：list 字段必须 JSON 数组语法（裸字符串会让服务拒绝启动）----
# 例：HE_CORS_ORIGINS=["http://8.149.232.63"] 或 ["https://example.com"]；同源托管填空数组即可
HE_CORS_ORIGINS=[]

# ---- 上游集成（暂不接保持留空，服务按未配置降级）----
HE_UPSTREAM_BASE_URL=
HE_UPSTREAM_TOKEN=
HE_SESSION_QUERY_BASE_URL=
HE_SESSION_QUERY_TOKEN=
HE_BAD_CASE_QUERY_BASE_URL=
HE_BAD_CASE_QUERY_TOKEN=

# ---- 自进化评测（可选；默认 fake，接真实评测平台时经 GitHub Secrets 注入）----
# HE_EVAL_MODE：fake（默认，占位分数）或 http（真实评测平台，需配 baseUrl）
# HE_EVAL_BASE_URL：评测平台地址，仅 http(s) 且不带凭据
# HE_EVAL_API_KEY：评测平台密钥；服务只保存 apiKeyRef（环境变量名），密钥值不落库
# 注入通道以 base64 传输、服务器侧解码后原子写入本文件，值含 & $ 反引号等特殊字符均安全
HE_EVAL_MODE=fake
HE_EVAL_BASE_URL=
HE_EVAL_API_KEY=

# ---- AI Agent（可选；由 deploy 流水线按 GitHub Secrets 注入，缺失即移除旧键）----
# AI_AGENT_PROVIDER：fake（确定性占位）/ claude-code（默认，调用部署的 claude CLI）；未知值启动失败。
# HE_AI_AGENT_FAILURE_POLICY：strict / degrade；留空按 provider 推导（fake=degrade，其余=strict）。
#   真实 provider 默认 strict：聚类 AI 失败让 run 显式失败，不落兜底 confidence/severity。
# HE_AI_AGENT_CLAUDE_BIN：CLI 路径；Deploy 在安装 Claude Code 时固定注入稳定 current 软链
#   /opt/harness/shared/claude-code/current/usr/bin/claude（harness 无 home，不要用 ~ 路径）。
# HE_AI_AGENT_CLAUDE_SETTINGS：共享 settings 路径；Deploy 注入
#   /opt/harness/shared/claude-code/config/settings.json（0644，不含密钥）。
# CLAUDE_CONFIG_DIR：同一共享 config 目录；CLAUDE_CODE_API_KEY 由 Deploy 以 ANTHROPIC_API_KEY
#   写入本 0600 文件，服务只把环境原样传给 CLI，不读取/打印/落库密钥。
# HE_PATCH_SOURCE_MODE：placeholder（默认）/ minimal-config / agent-edit。
# 缺失或为空的 Secret 由流水线移除对应键，服务回退上述 Settings 默认值；值含换行/回车时
# 流水线在注入前直接失败（跳过不是删除，旧值不会保留）。
AI_AGENT_PROVIDER=claude-code
HE_AI_AGENT_FAILURE_POLICY=
HE_AI_AGENT_CLAUDE_BIN=/opt/harness/shared/claude-code/current/usr/bin/claude
HE_AI_AGENT_CLAUDE_SETTINGS=/opt/harness/shared/claude-code/config/settings.json
CLAUDE_CONFIG_DIR=/opt/harness/shared/claude-code/config
ANTHROPIC_API_KEY=
HE_PATCH_SOURCE_MODE=placeholder

# ---- 任务租约与停机排水（默认值适用于单实例；心跳必须短于租约）----
# 重启时应用在排水窗口内等待在跑 job，超时释放租约并标 interrupted，下次启动续跑。
HE_JOB_LEASE_SECONDS=90
HE_JOB_HEARTBEAT_SECONDS=15
HE_JOB_DRAIN_TIMEOUT_SECONDS=25
